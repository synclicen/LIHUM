// LIHUM: Lihat untuk Umum - Prisma schema
// Photo gallery with Google Drive integration, multi-role access control.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Project {
  id              String   @id
  name            String
  description     String   @default("")
  driveFolderUrl  String
  driveFolderId   String
  displayMode     String   @default("all") // "all" | "search"
  autoSyncEnabled Boolean  @default(false)
  autoSyncInterval String  @default("5m") // "5m" | "15m" | "30m" | "1h" | "6h"
  needsSync       Int      @default(0) // 0 | 1 — set by Drive webhook, cleared by sync
  lastSyncedAt    String   @default("")
  photoCount      Int      @default(0)
  createdAt       String
  photos          Photo[]
}

// One Drive watch channel per admin (watches their entire Drive via changes/watch).
// Google sends a webhook to /api/drive-webhook when ANY file in the admin's Drive
// changes. We then mark needsSync=1 on all of that admin's auto-sync galleries,
// and the smart scheduler in the admin's browser picks it up within ~60s.
model DriveWatchChannel {
  id              String   @id // channel UUID
  userEmail       String   @unique // admin's email
  resourceId      String // Drive resource ID
  startPageToken  String // changes start token
  token           String // verification token (sent as X-Goog-Channel-Token)
  expiration      String // ISO timestamp when channel expires (max 24h)
  createdAt       String
  updatedAt       String
}

model Photo {
  id             String   // original Drive file id (NOT unique across projects)
  name           String
  mimeType       String   @default("")
  thumbnailLink  String   @default("")
  webContentLink String   @default("")
  size           String   @default("")
  createdTime    String   @default("")
  projectId      String
  project        Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@id([projectId, id])
  @@index([projectId])
}

model Account {
  id          String @id
  email       String @unique
  role        String @default("manager") // "admin" | "manager"
  displayName String @default("")
  addedAt     String
}
