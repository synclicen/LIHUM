{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "lihum",
  "main": ".open-next/worker.js",
  "compatibility_date": "2025-05-01",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "observability": {
    "enabled": true
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "lihum-db",
      "database_id": "dccb5f09-9607-4529-ac7d-d4a0e36f94d3"
    }
  ],
  "vars": {
    "APP_URL": "https://lihum.synclicen.workers.dev"
  }
}
